# ─── LLM ────────────────────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ─── Judge (LLM-as-judge eval) ─────────────────────
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=

# ─── PostgreSQL ─────────────────────────────────────
PGDATABASE=employee_handbook
PGUSER=user
PGPASSWORD=password
PGHOST=localhost
PGPORT=5432

# ─── Embeddings / Ingestion ─────────────────────────
TABLE_NAME=employee_handbook
VECTOR_DIM=384
MODEL_PATH=models/Xenova/all-MiniLM-L6-v2

# ─── GitHub source (ingestion) ─────────────────────
GITHUB_OWNER=madetech
GITHUB_REPO=handbook
GITHUB_BRANCH=main

# ─── Reranker ───────────────────────────────────────
RERANKER_ENABLED=false
RERANKER_MODEL_PATH=models/Xenova/ms-marco-MiniLM-L-6-v2

# ─── Query Rewriter ─────────────────────────────────
QUERY_REWRITER_ENABLED=false
QUERY_REWRITER_MODEL=

# ─── Cost tracking (per token) ──────────────────────
COST_PER_INPUT_TOKEN=0
COST_PER_OUTPUT_TOKEN=0
JUDGE_COST_PER_INPUT_TOKEN=0
JUDGE_COST_PER_OUTPUT_TOKEN=0

# ─── Retrieval eval ─────────────────────────────────
NUM_RESULTS=5
HYBRID_ALPHAS=0.2,0.5,0.8
GROUND_TRUTH_PATH=data/ground_truth.csv
EVAL_OUTPUT_DIR=data/evaluation

# ─── LLM eval ──────────────────────────────────────
NUM_QUESTIONS_PER_DOC=5
MAX_WORKERS=1

# ─── Rate limiting / retries ────────────────────────
MAX_EVAL_RPM=10
MAX_JUDGE_RPM=10
MAX_REQUESTS_PER_MINUTE=10
MAX_RETRIES=5
RETRY_BASE_DELAY=2
EVAL_SAMPLE_RATE=0.1

# ─── Grafana ────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
