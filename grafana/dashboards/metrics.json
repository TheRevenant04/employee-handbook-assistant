      "type": "table",
      "targets": [
        {
          "rawSql": "SELECT m.created_at, LEFT(m.question, 80) AS question, LEFT(m.answer, 120) AS answer, ROUND(mt.total_latency_ms, 0) AS total_ms, ROUND(mt.retrieval_latency_ms, 0) AS retrieval_ms, ROUND(mt.llm_latency_ms, 0) AS llm_ms, mt.input_tokens, mt.output_tokens, ROUND(mt.cost, 6) AS cost, mt.success, m.rating FROM chat.messages m LEFT JOIN chat.message_metrics mt ON mt.message_id = m.id ORDER BY m.created_at DESC LIMIT 20",
