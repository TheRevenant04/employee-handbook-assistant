# EditorConfig helps editors use consistent line endings and encoding
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Shell scripts
[*.sh]
indent_style = tab
indent_size = 1

# SQL files
[*.sql]
indent_style = space
indent_size = 2

# YAML / docker-compose
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Dockerfiles
[Dockerfile]
indent_style = space
indent_size = 2

# General config / text
[*.{md,json,env,env.example}]
indent_style = space
indent_size = 2